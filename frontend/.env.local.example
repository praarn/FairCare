# Backend base URL used by the browser. For bare-metal dev keep the IPv4
# loopback (see the comment in lib/api.ts about Windows + IPv6).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional: base URL for Next.js server-side (SSR) fetches only. Leave unset
# for bare-metal dev; docker-compose sets it to http://backend:8000 so SSR
# reaches the API container instead of the frontend container's own localhost.
# API_INTERNAL_BASE_URL=http://backend:8000
