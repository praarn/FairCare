# Keep shell scripts LF so they run inside Linux containers regardless of the
# host that checked them out.
*.sh text eol=lf
entrypoint.sh text eol=lf

# Normalise the rest of the text tree.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
