# Copy to .env at the repo root:  cp .env.example .env
# docker-compose reads this file automatically.

# ----- Postgres -----
POSTGRES_USER=faircare
POSTGRES_PASSWORD=faircare
POSTGRES_DB=faircare

# ----- backend -----
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_CONCURRENCY=2

# ----- Groq multimodal (bill-photo OCR + voice transcription) -----
# Leave GROQ_API_KEY blank to run without the multimodal features — the app
# still works; the bill-upload button and server voice fallback just hide.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# ----- frontend (baked into the browser bundle at build time) -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
