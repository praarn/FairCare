# Copy to backend/.env for bare-metal (non-Docker) runs. docker-compose passes
# these through from the repo-root .env instead.

APP_ENV=development
APP_VERSION=0.2.0
LOG_LEVEL=INFO

# For local Postgres. In docker-compose this is set to the "db" service host.
DATABASE_URL=postgresql+psycopg://sahaj:sahaj@localhost:5432/sahaj

# Comma-separated OR a JSON list.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000

# ----- Multimodal (Groq). Leave GROQ_API_KEY blank to disable bill/voice features. -----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# ----- rate limits (slowapi syntax) -----
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_MULTIMODAL=12/minute
